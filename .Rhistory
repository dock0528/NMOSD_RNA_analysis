mat <- as.matrix(NM0SD_log2cpm_control_genes_matrix)
# Friedman test（必须是数值矩阵，genes × patients）
friedman.test(mat)
pairwise.wilcox.test(long_NMOSD_log2cpm$Log2CPM,
long_NMOSD_log2cpm$Sample,
paired = TRUE,
p.adjust.method = "BH")
pw <- pairwise.wilcox.test(long_NMOSD_log2cpm$Log2CPM,
long_NMOSD_log2cpm$Sample,
paired = TRUE,
p.adjust.method = "BH")
# 拿出 p.value 矩阵并补齐对称和对角
p.mat <- pw$p.value
# 把对角设为 NA（或 1）
diag(p.mat) <- NA
# 画热图
library(pheatmap)
install.packages('pheatmap')
# 画热图
library(pheatmap)
pheatmap(p.mat,
display_numbers = TRUE,      # 在格子里显示 p 值
number_format   = "%.3f",    # 数字格式
cluster_rows    = FALSE,
cluster_cols    = FALSE,
main            = "Pairwise Wilcoxon BH‑adjusted p‑values",
color           = colorRampPalette(c("navy","white","firebrick3"))(50))
pheatmap(p.mat,
display_numbers = TRUE,      # 在格子里显示 p 值
